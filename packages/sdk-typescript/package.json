{
  "name": "@stablebaseline/sdk",
  "version": "0.10.1",
  "description": "TypeScript SDK for the Stable Baseline REST API. End-to-end agent-managed company brain: docs, diagrams, plans, databases, agents and a self-learning Knowledge Graph. 222 tools across 20 categories.",
  "homepage": "https://stablebaseline.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stablebaseline/mcp.git",
    "directory": "packages/sdk-typescript"
  },
  "bugs": "https://github.com/stablebaseline/mcp/issues",
  "license": "MIT",
  "keywords": [
    "stablebaseline",
    "stable-baseline",
    "mcp",
    "model-context-protocol",
    "knowledge-graph",
    "company-brain",
    "documentation",
    "diagrams",
    "plans",
    "ai-agent",
    "rest-api",
    "sdk",
    "typescript",
    "databases",
    "agents"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./types": {
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "src",
    "openapi.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "codegen": "openapi-typescript ./openapi.json -o ./src/types.generated.ts --empty-objects-unknown",
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "prepublishOnly": "npm run codegen && npm run build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "openapi-typescript": "^7.5.0",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
