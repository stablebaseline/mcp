{
  "name": "@stablebaseline/cli",
  "version": "0.4.1",
  "description": "sb — command-line client for Stable Baseline. End-to-end agent-managed company brain (docs, diagrams, plans, Knowledge Graph). 184 tools across 19 categories, all exposed at the CLI.",
  "homepage": "https://stablebaseline.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stablebaseline/mcp.git",
    "directory": "packages/cli"
  },
  "bugs": "https://github.com/stablebaseline/mcp/issues",
  "license": "MIT",
  "keywords": [
    "stablebaseline",
    "stable-baseline",
    "sb",
    "cli",
    "mcp",
    "model-context-protocol",
    "knowledge-graph",
    "company-brain",
    "documentation",
    "diagrams",
    "plans",
    "ai-agent"
  ],
  "type": "module",
  "bin": {
    "sb": "dist/sb.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/bin/sb.ts --format esm --dts --clean --shims",
    "dev": "tsx src/bin/sb.ts",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretest": "npm run build"
  },
  "dependencies": {
    "@stablebaseline/sdk": "^0.4.1",
    "commander": "^12.1.0",
    "kleur": "^4.1.5",
    "open": "^10.1.0"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "tsx": "^4.22.4",
    "typescript": "^5.6.3",
    "@types/node": "^22.19.19",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
